# Required. Encrypts your STI cookie jar in an httpOnly cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. When set, the app requires this password before any page loads.
# Strongly recommended for any public Vercel deployment.
APP_PASSWORD=

# Optional route overrides. Only /home is confirmed: it is the signed-in
# dashboard, and anonymous visitors are redirected to
# /site/not_logged_in?from=%2Fhome&log_in_required=true
# The others 404 today. Confirm them via /api/raw and set what is correct.
STI_DASHBOARD_PATH=/home
STI_COURSES_PATH=/courses
STI_ASSIGNMENTS_PATH=/assignments
STI_ANNOUNCEMENTS_PATH=/announcements